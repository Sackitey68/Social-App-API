{
  "info": {
    "name": "Social App API",
    "description": "Complete collection for the Social App API. Set the `baseUrl` variable and run Signup first to populate `token`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "postId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const body = pm.response.json();",
                "if (body.data) { pm.collectionVariables.set('token', body.data.token); pm.collectionVariables.set('userId', body.data.user.id); }"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"first_name\": \"Ama\",\n  \"last_name\": \"Mensah\",\n  \"username\": \"ama_{{ $randomInt }}\",\n  \"email\": \"ama_{{ $randomInt }}@test.com\",\n  \"password\": \"secret123\"\n}" },
            "url": "{{baseUrl}}/api/auth/signup"
          }
        },
        {
          "name": "Signin",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const body = pm.response.json();",
                "if (body.data) pm.collectionVariables.set('token', body.data.token);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"ama@test.com\",\n  \"password\": \"secret123\"\n}" },
            "url": "{{baseUrl}}/api/auth/signin"
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create Post",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const body = pm.response.json();",
                "if (body.data) pm.collectionVariables.set('postId', body.data.post.id);"
              ]
            }
          }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Hello world\",\n  \"content\": \"First post\",\n  \"tags\": [\"intro\"]\n}" },
            "url": "{{baseUrl}}/api/posts"
          }
        },
        {
          "name": "Publish Post",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "method": "PATCH",
            "url": "{{baseUrl}}/api/posts/{{postId}}/publish"
          }
        },
        {
          "name": "List Published Posts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/posts?page=1&limit=10&sort=-timestamp"
          }
        },
        {
          "name": "Get My Posts",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/posts/me?state=all"
          }
        },
        {
          "name": "Get Single Post",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/posts/{{postId}}" }
        }
      ]
    },
    {
      "name": "Likes",
      "item": [
        {
          "name": "Like Post",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "method": "POST",
            "url": "{{baseUrl}}/api/posts/{{postId}}/like"
          }
        },
        {
          "name": "Unlike Post",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "method": "DELETE",
            "url": "{{baseUrl}}/api/posts/{{postId}}/like"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Follow User",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "method": "POST",
            "url": "{{baseUrl}}/api/users/{{userId}}/follow"
          }
        },
        {
          "name": "My Followers",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users/{{userId}}/followers" }
        },
        {
          "name": "My Following",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users/{{userId}}/following" }
        }
      ]
    }
  ]
}
